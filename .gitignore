# Pythonのバイトコード（ネイティブ拡張の .pyd は一括除外しない）
__pycache__/
*.pyc
*.pyo

# 型チェック・テスト・静的解析のキャッシュ
.mypy_cache/
.pytest_cache/
.ruff_cache/
.cache/

# カバレッジの生成物
.coverage
.coverage.*
htmlcov/
coverage.xml

# 仮想環境
venv/
.venv/
env/
ENV/
.env/

# ローカルの環境変数設定（公開用の見本は保持する）
.env
.env.*
!.env.example
!.env.sample

# 実行ログ・計測ログと、VOICEVOXの生成音声
/src/logs/
/logs/
performance_*.jsonl
voice_cache/

# 一時ファイル
*.tmp
*.temp

# OS・個人エディタ設定
.DS_Store
Thumbs.db
Desktop.ini
.vscode/
.idea/

# PyInstallerの出力（再現用の .spec は管理できるようにする）
build/
dist/
